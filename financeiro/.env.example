# Configure no ambiente de execucao, nao faça commit de senhas reais.
DB_URL=jdbc:postgresql://localhost:5432/aera_financeiro
DB_USER=aera
DB_PASSWORD=troque-esta-senha
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=defina-uma-senha-forte
# Padrão: apenas acesso local. Para rede LAN, definir SERVER_ADDRESS explicitamente.
SERVER_ADDRESS=127.0.0.1
